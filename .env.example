OPENAI_API_KEY=your_api_key_here

# PostHog analytics (optional) — visit counts + pipeline funnel on Railway.
# Create a project at https://posthog.com (free tier: 1M events/month).
# VITE_* vars are baked in at build time — set them in Railway before deploy.
# VITE_POSTHOG_KEY=phc_your_project_api_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional overrides (defaults shown)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_SIMULATE=gpt-4o
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_PRD=gpt-4o

# Reddit API (optional) — enables reliable "real user voices" from Reddit.
# Without these, Reddit is skipped (its public search endpoint blocks bots).
# Create an app at https://www.reddit.com/prefs/apps (type: "script" or "web app").
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret
# REDDIT_USER_AGENT=UserResearchOS/1.0 (by /u/yourusername)
